%% ===================== SERVER: ESTRUCTURAS =====================
namespace Server_Estructuras {
    class NodeJugador {
        +Jugador Data
        +NodeJugador Next
        +NodeJugador Previous
    }
    class NodeCasilla {
        +Casilla Data
        +NodeCasilla Next
        +NodeCasilla Previous
    }
    class NodeCartaEvento {
        +CartaEvento Data
        +NodeCartaEvento Next
        +NodeCartaEvento Previous
    }
    class NodeTransaccion {
        +Transaccion Data
        +NodeTransaccion Next
        +NodeTransaccion Previous
    }
    class ColaCircular {
        +NodeJugador Head
        +NodeJugador Tail
        +int Size
        +Enqueue(Jugador jugador)
        +Dequeue() Jugador
        +Advance()
        +Peek() Jugador
    }
    class ColaCartasEvento {
        +NodeCartaEvento Head
        +NodeCartaEvento Tail
        +int Size
        +Enqueue(CartaEvento carta)
        +Dequeue() CartaEvento
        +Advance()
        +Peek() CartaEvento
        +Inicializar()
    }
    class ListaDobleEnlazada {
        +NodeCasilla Head
        +NodeCasilla Tail
        +int Size
        +Add(Casilla data)
        +Remove(Casilla data)
        +GetAt(int indicePropiedad) Casilla
        +GetById(int id) Casilla
    }
    class ListaTransacciones {
        +NodeTransaccion Head
        +NodeTransaccion Tail
        +int Size
        +Add(Transaccion data)
        +RecorrerDesdeInicio()
        +RecorrerDesdeFinal()
        +BuscarPorJugador(Jugador jugador) Transaccion
        +BuscarPorTipo(TipoTransaccion tipo) Transaccion
        +Display()
    }
}

%% ===================== HERENCIA / REALIZACION =====================
Casilla <|-- Propiedad
Casilla <|-- CasillaEvento
Casilla <|-- CasillaEspecial

%% ===================== ENUMERACIONES =====================
CasillaEspecial --> SubtipoCasillaEspecial : Subtipo
CartaEvento --> TipoCartaEvento : Tipo
Transaccion --> TipoTransaccion : Tipo
Casilla ..> AccionCasilla : devuelve
Tablero ..> AccionCasilla : devuelve

%% ===================== ESTRUCTURAS DE DATOS =====================
ColaCircular *-- NodeJugador
NodeJugador --> Jugador : Data
ColaCartasEvento *-- NodeCartaEvento
NodeCartaEvento --> CartaEvento : Data
Tablero *-- NodeCasilla : lista circular
ListaDobleEnlazada *-- NodeCasilla
NodeCasilla --> Casilla : Data
ListaTransacciones *-- NodeTransaccion
NodeTransaccion --> Transaccion : Data

%% ===================== MODELO =====================
Jugador *-- ListaDobleEnlazada : PropiedadesAdquiridas
Jugador --> Casilla : Posicion
Propiedad --> Jugador : Propietario
Transaccion --> Jugador : Origen y Destino
Banco *-- ListaTransacciones
Banco ..> Transaccion : crea
Banco ..> Propiedad : compra / vende

%% ===================== MOTOR =====================
Juego *-- Tablero
Juego *-- ManejadorAcciones
Juego *-- ColaCircular : turnos
Juego *-- Dado
Juego "1" o-- "4" Jugador
ManejadorAcciones *-- Banco
ManejadorAcciones *-- ColaCartasEvento
ManejadorAcciones --> Tablero
ManejadorAcciones ..> AccionCasilla
ManejadorAcciones ..> CartaEvento